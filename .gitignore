.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# NOTE: reports/ (the CSV summary + figures) is intentionally NOT ignored -
# commit these. They're small, they're the evidence the README's numbers
# are real, and GitHub renders the PNGs inline in the README preview.

# Raw data: the ASOS file is small (2.7MB) and CC/MIT-friendly to keep in
# the repo for reproducibility. Online Retail II and Trustpilot are much
# larger (tens/hundreds of MB) - keep these LOCAL ONLY, never commit them.
# GitHub will reject anything over 100MB anyway, and it's bad practice to
# store large data files in git even under that limit.
data/raw/online_retail/*.csv
data/raw/trustpilot/*.csv
data/processed/*

.DS_Store

